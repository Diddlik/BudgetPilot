@page "/einstellungen"
@rendermode InteractiveServer
@using BudgetPilot.Domain.Exceptions
@inject IHouseholdSettingsService HouseholdSettings

<PageTitle>Einstellungen · BudgetPilot</PageTitle>

<header class="page-header">
    <div>
        <p class="eyebrow">Haushalt</p>
        <h1>Einstellungen</h1>
    </div>
</header>

@if (settings is null)
{
    <p>Lade Einstellungen ...</p>
}
else
{
    @if (error is not null)
    {
        <div class="alert" role="alert">@error</div>
    }
    @if (info is not null)
    {
        <div class="alert success" role="status">@info</div>
    }

    <section class="panel">
        <header class="panel-header">
            <div>
                <h2>Haushaltszeit</h2>
                <p class="hint">Bestimmt, wann für BudgetPilot ein neuer Tag und Monat beginnt.</p>
            </div>
            <span class="date-chip">Heute: @settings.Today.ToString("dd.MM.yyyy")</span>
        </header>
        <div class="inline-form">
            <label>Zeitzone
                <select class="field" @bind="selectedTimeZoneId">
                    @foreach (var zone in settings.AvailableTimeZones)
                    {
                        <option value="@zone.Id">@zone.DisplayName · @zone.Id</option>
                    }
                </select>
            </label>
            <label>Zahlungen verfolgen ab
                <input class="field" type="date" @bind="selectedTrackingStartDate" @bind:format="yyyy-MM-dd" />
            </label>
            <button class="button secondary" type="button" @onclick="UseCurrentMonth">Ab diesem Monat</button>
            <button class="button primary" @onclick="SaveAsync">Speichern</button>
        </div>
        <p class="hint">Für einen Haushalt in Deutschland ist <strong>Europe/Berlin</strong> richtig – inklusive automatischer Sommerzeit.</p>
        <p class="hint">Ältere Vertrags- und Planungsdaten bleiben erhalten. Nur offene Zahlungen vor diesem Datum werden nicht als Aufgaben angezeigt.</p>
    </section>
}

@code {
    private HouseholdSettingsDto? settings;
    private string selectedTimeZoneId = string.Empty;
    private DateOnly selectedTrackingStartDate;
    private string? error;
    private string? info;

    protected override async Task OnInitializedAsync()
    {
        settings = await HouseholdSettings.GetAsync();
        selectedTimeZoneId = settings.TimeZoneId;
        selectedTrackingStartDate = settings.OccurrenceTrackingStartDate;
    }

    private async Task SaveAsync()
    {
        error = info = null;
        try
        {
            settings = await HouseholdSettings.UpdateAsync(new(selectedTimeZoneId, selectedTrackingStartDate));
            selectedTimeZoneId = settings.TimeZoneId;
            selectedTrackingStartDate = settings.OccurrenceTrackingStartDate;
            info = "Die Haushaltseinstellungen wurden gespeichert.";
        }
        catch (DomainException ex)
        {
            error = ex.Message;
        }
    }

    private void UseCurrentMonth() =>
        selectedTrackingStartDate = new DateOnly(settings!.Today.Year, settings.Today.Month, 1);
}
