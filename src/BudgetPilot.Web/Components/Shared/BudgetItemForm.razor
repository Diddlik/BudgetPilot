@rendermode InteractiveServer
@using BudgetPilot.Domain.Exceptions
@inject IBudgetItemService Items
@inject ICategoryService Categories
@inject IHouseholdSettingsService HouseholdSettings

<div class="modal-backdrop" @onmousedown="OnBackdropPointerDown" @onclick="OnBackdropClick">
    <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="budget-form-title"
             @onmousedown="OnSheetPointerDown" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
        <header class="sheet-header">
            <div>
                <p class="eyebrow">@ModeTitle</p>
                <h2 id="budget-form-title">@Heading</h2>
            </div>
            <button type="button" class="icon-button" title="Schließen" @onclick="Cancel">×</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert" role="alert">@error</div>
        }

        @if (ModeMessage is { } modeMessage)
        {
            <div class="form-context @(Mode == "EditVersion" ? "warning" : null)">@modeMessage</div>
        }

        <div class="type-choice" aria-label="Art der Position">
            <button type="button" class="type-option expense @(Type == BudgetItemType.Expense ? "selected" : null)"
                    disabled="@MetadataLocked" aria-pressed="@(Type == BudgetItemType.Expense)"
                    @onclick="() => Type = BudgetItemType.Expense">
                <span aria-hidden="true">−</span><strong>Ausgabe</strong><small>Geld geht vom Haushalt ab</small>
            </button>
            <button type="button" class="type-option income @(Type == BudgetItemType.Income ? "selected" : null)"
                    disabled="@MetadataLocked" aria-pressed="@(Type == BudgetItemType.Income)"
                    @onclick="() => Type = BudgetItemType.Income">
                <span aria-hidden="true">+</span><strong>Einnahme</strong><small>Geld kommt zum Haushalt hinzu</small>
            </button>
        </div>

        <div class="form-grid">
            <label>
                Wofür ist diese Position?
                <input class="field" @bind="Name" disabled="@MetadataLocked" maxlength="160"
                       autocomplete="off" placeholder="z. B. Miete oder Gehalt" />
            </label>

            <label>
                Kategorie
                <select class="field" @bind="CategoryId" disabled="@MetadataLocked">
                    <option value="@Guid.Empty">Bitte auswählen</option>
                    @foreach (var category in activeCategories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </label>

            <label>
                Betrag
                <input class="field numeric" inputmode="decimal" placeholder="0,00" @bind="AmountText" @bind:event="oninput" />
                <span class="field-help">Euro pro Zahlung</span>
            </label>

            <label>
                Wie oft?
                <select class="field" @bind="Frequency">
                    <option value="@BudgetFrequency.Monthly">Monatlich</option>
                    <option value="@BudgetFrequency.Quarterly">Quartalsweise</option>
                    <option value="@BudgetFrequency.Yearly">Jährlich</option>
                    <option value="@BudgetFrequency.Once">Einmalig</option>
                </select>
            </label>

            <label>
                @(Frequency == BudgetFrequency.Once ? "Zahlungsdatum" : "Erste geplante Zahlung")
                <input class="field" type="date" value="@ValidFromText" @onchange="OnValidFromChanged" />
            </label>

            @if (Mode == "EditVersion")
            {
                <label>
                    Zeitraum endet am (optional)
                    <input class="field" type="date" value="@ValidToText" @onchange="OnValidToChanged" />
                    <span class="hint">Nur für eine historische Korrektur.</span>
                </label>
            }
        </div>

        <details class="optional-fields">
            <summary>Weitere Angaben <span>optional</span></summary>
            <div class="form-grid">
                <label>
                    Zuständig
                    <input class="field" list="owner-suggestions" placeholder="z. B. Gemeinsam" @bind="Owner" disabled="@MetadataLocked" />
                    <datalist id="owner-suggestions">
                        <option value="Mann" />
                        <option value="Frau" />
                        <option value="Gemeinsam" />
                    </datalist>
                </label>

                @if (Frequency != BudgetFrequency.Once)
                {
                    <label>
                        Abweichender Zahlungstag
                        <input class="field" type="number" min="1" max="31" inputmode="numeric" placeholder="aus Startdatum" @bind="PaymentDay" />
                    </label>
                }

                @if (Frequency == BudgetFrequency.Yearly)
                {
                    <label>
                        Abweichender Zahlungsmonat
                        <select class="field" @bind="PaymentMonth">
                            <option value="">aus Startdatum</option>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@culture.DateTimeFormat.GetMonthName(month)</option>
                            }
                        </select>
                    </label>
                }

                <label class="span-2">
                    Notiz
                    <textarea class="field" rows="2" maxlength="500" placeholder="Nur wenn sie später beim Einordnen hilft" @bind="Note"></textarea>
                </label>
            </div>
        </details>

        @if (Preview.Count > 0)
        {
            <section class="due-preview" aria-live="polite">
                <div><span class="preview-kicker">So wird geplant</span><strong>@PreviewTitle</strong></div>
                <ol>
                    @foreach (var entry in Preview)
                    {
                        <li><time datetime="@entry.DueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@entry.DueDate.ToString("dd. MMM yyyy", culture)</time><strong>@entry.Amount.ToString("C", culture)</strong></li>
                    }
                </ol>
            </section>
        }

        <footer class="sheet-actions">
            <button type="button" class="button secondary" @onclick="Cancel">Abbrechen</button>
            <button type="button" class="button primary" disabled="@(!CanSave)" @onclick="SaveAsync">Speichern</button>
        </footer>
    </section>
</div>

@code {
    [Parameter] public string Mode { get; set; } = "Create";
    [Parameter] public BudgetItemDto? Item { get; set; }
    [Parameter] public Guid? VersionId { get; set; }
    [Parameter] public Guid? PresetCategoryId { get; set; }
    [Parameter] public EventCallback<BudgetItemDto?> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly CultureInfo culture = CultureInfo.GetCultureInfo("de-DE");
    private List<CategoryDto> activeCategories = [];
    private string Name { get; set; } = string.Empty;
    private string? Owner { get; set; }
    private BudgetItemType Type { get; set; } = BudgetItemType.Expense;
    private Guid CategoryId { get; set; }
    private string AmountText { get; set; } = string.Empty;
    private BudgetFrequency Frequency { get; set; } = BudgetFrequency.Monthly;
    private string ValidFromText { get; set; } = string.Empty;
    private DateOnly today;
    private string ValidToText { get; set; } = string.Empty;
    private int? PaymentDay { get; set; }
    private int? PaymentMonth { get; set; }
    private string? Note { get; set; }
    private string? error;

    // Stammdaten (Name/Typ/Kategorie/Inhaber) sind bei reinen Versions-Operationen gesperrt.
    private bool MetadataLocked => Mode is "Version" or "EditVersion";
    private string ModeTitle => Mode switch
    {
        "Edit" => "Bearbeiten",
        "Version" => "Änderung ab Stichtag",
        "EditVersion" => "Historische Korrektur",
        _ => "Neue Position"
    };
    private string? ModeMessage => Mode switch
    {
        "Version" => "Du änderst den Plan ab dem gewählten Datum. Frühere Monate bleiben unverändert.",
        "EditVersion" => "Du korrigierst einen bereits gespeicherten Zeitraum. Das kann historische Auswertungen verändern.",
        _ => null
    };
    private string Heading => Mode switch
    {
        "Edit" => "Position bearbeiten",
        "Version" => "Betrag ab Datum ändern",
        "EditVersion" => "Version korrigieren",
        _ => Type == BudgetItemType.Income ? "Neue Einnahme" : "Neue Ausgabe"
    };
    private bool CanSave => !string.IsNullOrWhiteSpace(Name) && TryParseAmount(out var amount) && amount >= 0 && DateOnly.TryParse(ValidFromText, out _) && CategoryId != Guid.Empty;
    private IReadOnlyList<PaymentSchedulePreviewEntry> Preview => BuildPreview();
    private string PreviewTitle => Frequency == BudgetFrequency.Once ? "Einmalige Zahlung" : "Nächste drei Zahlungen";
    private int? EffectivePaymentDay => Frequency == BudgetFrequency.Once ? null : PaymentDay;
    private int? EffectivePaymentMonth => Frequency == BudgetFrequency.Yearly ? PaymentMonth : null;

    protected override async Task OnInitializedAsync()
    {
        today = await HouseholdSettings.GetTodayAsync();
        activeCategories = (await Categories.GetAllAsync()).Where(c => c.IsActive).OrderBy(c => c.Name).ToList();
        PopulateFromParameters();
    }

    private void PopulateFromParameters()
    {
        // Bei "EditVersion" die konkret gewählte Version vorbelegen, sonst die aktuelle.
        var source = (Mode == "EditVersion" && VersionId is { } vid
            ? Item?.Versions.FirstOrDefault(v => v.Id == vid)
            : null)
            ?? Item?.Versions.OrderByDescending(v => v.ValidFrom).FirstOrDefault(v => v.IsCurrent)
            ?? Item?.Versions.OrderByDescending(v => v.ValidFrom).FirstOrDefault();

        Name = Item?.Name ?? string.Empty;
        Owner = Item?.Owner;
        Type = Item?.Type ?? BudgetItemType.Expense;
        CategoryId = PresetCategoryId ?? Item?.CategoryId ?? Guid.Empty;
        // Beim Anlegen leer lassen – der Platzhalter zeigt das Format, kein hart gesetztes 0,00.
        AmountText = source?.Amount.ToString("N2", culture) ?? string.Empty;
        Frequency = source?.Frequency ?? BudgetFrequency.Monthly;
        // Bei "Version" (neue Version) heute vorbelegen; sonst das Datum der Quelle.
        ValidFromText = (Mode == "Version" ? today : source?.ValidFrom ?? today)
            .ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        ValidToText = Mode == "EditVersion"
            ? source?.ValidTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty
            : string.Empty;
        PaymentDay = source?.PaymentDay;
        PaymentMonth = source?.PaymentMonth;
        Note = source?.Note;
    }

    private async Task SaveAsync()
    {
        if (!CanSave || !TryParseAmount(out var amount) || !DateOnly.TryParse(ValidFromText, out var validFrom))
        {
            return;
        }

        try
        {
            BudgetItemDto? saved = null;
            if (Mode == "Edit" && Item is not null)
            {
                saved = await Items.UpdateMetadataAsync(Item.Id, new UpdateBudgetItemMetadataRequest(Name.Trim(), Item.Description, Type, CategoryId, Owner));
                await Items.UpdateCurrentVersionAsync(Item.Id, new UpdateVersionRequest(amount, Frequency, validFrom, EffectivePaymentDay, EffectivePaymentMonth, Note));
                saved = await Items.GetByIdAsync(Item.Id);
            }
            else if (Mode == "Version" && Item is not null)
            {
                await Items.AddVersionAsync(Item.Id, new CreateBudgetItemVersionRequest(amount, Frequency, validFrom, EffectivePaymentDay, EffectivePaymentMonth, Note));
                saved = await Items.GetByIdAsync(Item.Id);
            }
            else if (Mode == "EditVersion" && Item is not null && VersionId is { } versionId)
            {
                var validTo = DateOnly.TryParse(ValidToText, out var parsedTo) ? parsedTo : (DateOnly?)null;
                await Items.UpdateVersionAsync(Item.Id, versionId, new UpdateVersionRequest(amount, Frequency, validFrom, EffectivePaymentDay, EffectivePaymentMonth, Note, validTo));
                saved = await Items.GetByIdAsync(Item.Id);
            }
            else
            {
                saved = await Items.CreateAsync(new CreateBudgetItemRequest(Name.Trim(), null, Type, CategoryId, amount, Frequency, validFrom, EffectivePaymentDay, EffectivePaymentMonth, Note, Owner));
            }

            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private bool TryParseAmount(out decimal amount)
    {
        var text = AmountText.Trim();
        // de-DE handles "1.200,00" (thousands dot + decimal comma) and "1200,00"
        if (decimal.TryParse(text, NumberStyles.Number, culture, out amount))
            return true;
        // Fallback: user typed English decimal dot without any comma ("1200.50")
        if (!text.Contains(','))
            return decimal.TryParse(text.Replace('.', ','), NumberStyles.Number, culture, out amount);
        return false;
    }

    private IReadOnlyList<PaymentSchedulePreviewEntry> BuildPreview()
    {
        if (!TryParseAmount(out var amount) || amount < 0 || !DateOnly.TryParse(ValidFromText, out var validFrom))
        {
            return [];
        }

        try
        {
            return PaymentSchedulePreview.Build(new CreateBudgetItemVersionRequest(
                amount, Frequency, validFrom, EffectivePaymentDay, EffectivePaymentMonth, Note));
        }
        catch (DomainException)
        {
            return [];
        }
    }

    private void OnValidFromChanged(ChangeEventArgs args)
    {
        ValidFromText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnValidToChanged(ChangeEventArgs args)
    {
        ValidToText = args.Value?.ToString() ?? string.Empty;
    }

    // Schließen nur, wenn der Klick wirklich auf dem Hintergrund begann. Verhindert,
    // dass das Markieren von Text im Betragsfeld (Maus-Loslassen außerhalb des Fensters)
    // das Popup ungewollt schließt.
    private bool pointerDownOnBackdrop;

    private void OnBackdropPointerDown() => pointerDownOnBackdrop = true;

    private void OnSheetPointerDown() => pointerDownOnBackdrop = false;

    private async Task OnBackdropClick()
    {
        if (!pointerDownOnBackdrop)
        {
            return;
        }
        pointerDownOnBackdrop = false;
        await Cancel();
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
