<section class="panel comparison-panel">
    <header class="panel-header">
        <div>
            <p class="eyebrow">Haushaltsbuch</p>
            <h2>Berücksichtigter Stand</h2>
        </div>
        <span>@PeriodLabel</span>
    </header>

    <div class="comparison-grid">
        <ComparisonCard Label="Einnahmen" Value="Comparison.ActualIncome" />
        <ComparisonCard Label="Ausgaben" Value="Comparison.ActualExpense" />
        <ComparisonCard Label="Saldo" Value="Comparison.ActualBalance" />
    </div>
    <p class="hint">Fällige Budgetpositionen werden automatisch berücksichtigt. Gespeichert werden nur Abweichungen und Ausfälle.</p>
</section>

@code {
    [Parameter, EditorRequired] public PlanActualComparisonDto Comparison { get; set; } = null!;

    private readonly CultureInfo culture = CultureInfo.GetCultureInfo("de-DE");
    private string PeriodLabel => Comparison.Month is { } month
        ? new DateOnly(Comparison.Year, month, 1).ToString("MMMM yyyy", culture)
        : Comparison.Year.ToString(culture);
}
