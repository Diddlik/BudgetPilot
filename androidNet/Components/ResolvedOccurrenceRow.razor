@inject BudgetPilotApiClient Api

<article class="resolved-entry">
    <div class="resolved-main">
        <div>
            <strong>@Resolution.BudgetItemName</strong>
            <span>@Resolution.CategoryName · geplant @Resolution.PlannedDueDate.ToString("dd.MM.yyyy")</span>
        </div>
        <span class="pill @(Resolution.Kind == OccurrenceResolutionKind.Confirmed ? "positive" : "neutral")">@Status</span>
        <strong class="numeric">@AmountLabel</strong>
    </div>

    @if (mode is null)
    {
        <div class="row-actions">
            @if (Resolution.Kind == OccurrenceResolutionKind.Confirmed)
            {
                <button class="small-action" disabled="@busy" @onclick="() => mode = ActionMode.Correct">Korrigieren</button>
            }
            <button class="small-action" disabled="@busy" @onclick="() => mode = ActionMode.Reopen">Wieder öffnen</button>
        </div>
    }
    else if (mode == ActionMode.Correct)
    {
        <div class="occurrence-editor">
            <label>Betrag<input class="field" type="number" min="0" step="0.01" @bind="amount" /></label>
            <label>Bezahlt am<input class="field" type="date" @bind="actualDate" /></label>
            <label class="wide">Notiz (optional)<input class="field" maxlength="500" @bind="note" /></label>
            <div class="row-actions wide">
                <button class="small-action" disabled="@busy" @onclick="CorrectAsync">Korrektur speichern</button>
                <button class="small-action" disabled="@busy" @onclick="Close">Abbrechen</button>
            </div>
        </div>
    }
    else
    {
        <div class="occurrence-editor">
            <p class="wide muted">Die Fälligkeit wird danach wieder automatisch berücksichtigt.</p>
            <div class="row-actions wide">
                <button class="small-action danger" disabled="@busy" @onclick="ReopenAsync">Wirklich wieder öffnen</button>
                <button class="small-action" disabled="@busy" @onclick="Close">Abbrechen</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="alert compact">@error</p>
    }
</article>

@code {
    private static readonly CultureInfo GermanCulture = CultureInfo.GetCultureInfo("de-DE");

    [Parameter, EditorRequired] public OccurrenceResolutionDto Resolution { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }

    private ActionMode? mode;
    private decimal amount;
    private DateOnly actualDate;
    private string? note;
    private bool busy;
    private string? error;

    protected override void OnParametersSet()
    {
        if (mode is null)
        {
            amount = Resolution.ActualAmount ?? Resolution.PlannedAmount;
            actualDate = Resolution.ActualDate ?? Resolution.PlannedDueDate;
            note = Resolution.Note;
        }
    }

    private string Status => Resolution.Kind == OccurrenceResolutionKind.Confirmed ? "Angepasst" : "Entfallen";
    private string AmountLabel => Resolution.Kind == OccurrenceResolutionKind.Confirmed
        ? (Resolution.ActualAmount ?? 0m).ToString("C", GermanCulture)
        : "–";

    private async Task CorrectAsync() => await ExecuteAsync(async () =>
    {
        await Api.CorrectOccurrenceAsync(
            Resolution.BudgetItemId,
            Resolution.PlannedDueDate,
            new CorrectOccurrenceRequest(amount, actualDate, note));
    });

    private async Task ReopenAsync() => await ExecuteAsync(() =>
        Api.ReopenOccurrenceAsync(Resolution.BudgetItemId, Resolution.PlannedDueDate));

    private async Task ExecuteAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        try
        {
            await action();
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void Close()
    {
        mode = null;
        error = null;
    }

    private enum ActionMode { Correct, Reopen }
}
