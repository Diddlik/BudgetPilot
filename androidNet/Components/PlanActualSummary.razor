<section class="panel comparison-panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow">Haushaltsbuch</p>
            <h2>Berücksichtigter Stand</h2>
        </div>
    </div>
    <div class="comparison-grid">
        <article class="comparison-card">
            <strong>Einnahmen</strong><span>@Money(Comparison.ActualIncome)</span>
        </article>
        <article class="comparison-card">
            <strong>Ausgaben</strong><span>@Money(Comparison.ActualExpense)</span>
        </article>
        <article class="comparison-card">
            <strong>Saldo</strong><span>@Money(Comparison.ActualBalance)</span>
        </article>
    </div>
    <p class="muted">Fällige Budgetpositionen werden automatisch berücksichtigt. Gespeichert werden nur Abweichungen und Ausfälle.</p>
</section>

@code {
    [Parameter, EditorRequired] public PlanActualComparisonDto Comparison { get; set; } = null!;
    private static readonly CultureInfo GermanCulture = CultureInfo.GetCultureInfo("de-DE");
    private static string Money(decimal value) => value.ToString("C", GermanCulture);
}
